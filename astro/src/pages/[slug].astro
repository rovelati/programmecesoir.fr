---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getChannelBySlug, getChannelSlugFromId, getProgramsByChannelAndDate, getTodayDateFR } from '../utils/supabase';
import { formatDateFR, isCurrentlyAiring } from '../utils/dates';
import { getRelatedChannelsForSchedule } from '../utils/relatedChannels';
import RelatedChannels from '../components/RelatedChannels.astro';
import ScheduleProgramRow from '../components/ScheduleProgramRow.astro';
import AdSlot from '../components/AdSlot.astro';
import { ADSENSE_SLOTS } from '../utils/adsense';
import { setCacheControl, CACHE_TEN_MINUTES } from '../utils/cachePolicy';
import { channelSeoName, channelTodaySeo } from '../utils/seoCopy';
import { isAdultOrJunkChannel, programPath } from '../utils/programSeo';
import { buildChannelScheduleJsonLd } from '../utils/channelJsonLd';
import { pickFeaturedProgram } from '../utils/programPick';
import { resolveProgramPoster } from '../utils/programPoster';
import { resolveOgImage } from '../utils/seoImage';
import { getTvStreamUrl } from '../utils/tvStreams';
import { getTntNumber, isSuisse, isPayant, isTntLocale } from '../utils/channelUrls';
import { getChannelLogo } from '../utils/channelLogos';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/');

const reserved = new Set([
  'ce-soir', 'maintenant', 'en-direct', 'demain', 'programme', 'recherche',
  'politique-cookies', 'conditions-generales', 'credits', 'films', 'film',
  'series', 'serie', 'acteurs', 'acteur', 'recommandes', 'film-ce-soir',
  'series-ce-soir', 'sport-ce-soir', 'documentaires-ce-soir', 'jeunesse-ce-soir',
  'culture-ce-soir', 'infos-ce-soir', 'divertissement-ce-soir', 'actualites',
  'anniversaire-du-jour', 'anniversaires-acteurs', 'robots.txt', 'sitemap.xml',
]);

if (reserved.has(slug)) return new Response(null, { status: 404 });

const channel = await getChannelBySlug(slug);

if (!channel) {
  return new Response(null, { status: 404 });
}

setCacheControl(Astro.response, CACHE_TEN_MINUTES);

const today = await getTodayDateFR();
const programs = await getProgramsByChannelAndDate(channel.channel_id, today);
const relatedChannels = await getRelatedChannelsForSchedule(channel, programs, 'aujourdhui', today, 6);
const todayFormatted = formatDateFR(new Date());
const chSlug = getChannelSlugFromId(channel.channel_id);
const canonical = `https://programmecesoir.fr/${chSlug}`;
const seoName = channelSeoName(chSlug, channel.name);
const { title: pageTitle, description: pageDescription } = channelTodaySeo(seoName);
const noindex = isAdultOrJunkChannel(chSlug);

const resolvedLogo = getChannelLogo(channel.channel_id, channel.logo_url, channel.name);
const primeProgram = pickFeaturedProgram(programs, 'ce-soir');
const primePoster = primeProgram ? resolveProgramPoster(primeProgram) : null;
const ogImage = resolveOgImage(primePoster, resolvedLogo);
const tvStream = getTvStreamUrl(chSlug, channel.name);
const tntNum = getTntNumber(channel.channel_number, chSlug);
const isSwiss = isSuisse(chSlug);
const isPaid = isPayant(channel.channel_number, chSlug);
const isLocal = isTntLocale(chSlug);

const nowMs = Date.now();
const pastPrograms = programs.filter(p => new Date(p.end_time).getTime() < nowMs);
const currentProgram = programs.find(p => isCurrentlyAiring(p.start_time, p.end_time));
const upcomingPrograms = programs.filter(p => new Date(p.end_time).getTime() >= nowMs && p.id !== currentProgram?.id);

const schedulePayload = programs.map(p => ({
  id: p.id,
  title: p.title,
  start: new Date(p.start_time).getTime(),
  end: new Date(p.end_time).getTime(),
  genre: p.genre || '',
  description: p.description ? p.description.slice(0, 160) : '',
  href: programPath(chSlug, p.title),
}));

const TOP_CHANNELS = [
  { slug: 'tf1', name: 'TF1' },
  { slug: 'france-2', name: 'France 2' },
  { slug: 'france-3', name: 'France 3' },
  { slug: 'canal-plus', name: 'Canal+' },
  { slug: 'france-5', name: 'France 5' },
  { slug: 'm6', name: 'M6' },
  { slug: 'arte', name: 'ARTE' },
  { slug: 'c8', name: 'C8' },
  { slug: 'w9', name: 'W9' },
  { slug: 'tmc', name: 'TMC' },
  { slug: 'cnews', name: 'CNews' },
  { slug: 'kto', name: 'KTO' },
  { slug: 'antenne-reunion', name: 'Antenne Réunion' },
  { slug: '2m-maroc', name: '2M Maroc' },
  { slug: 'rts-1', name: 'RTS 1' },
  { slug: 'tvpi', name: 'TVPI' },
  { slug: 'rtl9', name: 'RTL9' },
  { slug: '6ter', name: '6ter' },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: `Quel est le programme TV de ${seoName} aujourd'hui ?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: `Retrouvez sur cette page la grille complète des émissions, films, séries et journaux d'information diffusés aujourd'hui sur ${seoName}, du matin jusqu'au soir.`,
      },
    },
    {
      '@type': 'Question',
      name: `Quel est le programme de ${seoName} en direct et ce soir ?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: `Consultez https://programmecesoir.fr/en-direct/${chSlug} pour voir l'émission diffusée en direct à l'antenne, et https://programmecesoir.fr/ce-soir/${chSlug} pour le programme de première partie de soirée (21h10).`,
      },
    },
  ],
};

const jsonLd = [
  ...buildChannelScheduleJsonLd({
    channel: { ...channel, logo_url: resolvedLogo },
    channelSlug: chSlug,
    channelName: seoName,
    canonical,
    view: 'aujourdhui',
    programs,
  }),
  faqJsonLd,
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
  noindex={noindex}
  image={ogImage}
  jsonLd={jsonLd}
>
  <Header slot="header" activePath={`/${chSlug}`} />

  <div class="container mx-auto px-3 sm:px-4 py-5 sm:py-8 max-w-5xl">
    <!-- Channel Header Banner with Neuromarketing Styling -->
    <div class="p-5 sm:p-7 bg-[#111827]/95 rounded-3xl border border-gray-800/90 shadow-2xl mb-6 flex flex-col md:flex-row md:items-center justify-between gap-5">
      <div class="flex items-center gap-4 sm:gap-5">
        <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-black/60 border border-gray-800 p-2.5 flex items-center justify-center shrink-0 shadow-sm">
          <img
            src={resolvedLogo}
            alt={`Logo ${seoName}`}
            class="max-h-full max-w-full object-contain"
            width="80"
            height="80"
          />
        </div>
        <div>
          <div class="flex items-center gap-2 mb-1 flex-wrap">
            {tntNum != null ? (
              <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-black uppercase bg-gray-900 text-white border border-gray-800 tracking-wider">
                TNT {tntNum}
              </span>
            ) : isSwiss ? (
              <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-black uppercase bg-rose-950/60 text-rose-300 border border-rose-800/50 tracking-wider">
                🇨🇭 Suisse
              </span>
            ) : isPaid ? (
              <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-black uppercase bg-amber-950/60 text-amber-300 border border-amber-800/50 tracking-wider">
                Payant
              </span>
            ) : isLocal ? (
              <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-black uppercase bg-emerald-950/60 text-emerald-300 border border-emerald-800/50 tracking-wider">
                TNT Locale
              </span>
            ) : null}
            <span class="inline-flex items-center gap-1.5 text-[11px] font-bold text-gray-400" id="live-paris-clock">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              <span id="paris-clock-text">En direct</span>
            </span>
          </div>

          <h1 class="text-2xl sm:text-3xl font-black text-white tracking-tight">
            Programme TV {seoName} aujourd'hui
          </h1>
          <p class="text-xs sm:text-sm text-gray-400 capitalize mt-0.5">
            Grille complète des émissions • {todayFormatted}
          </p>
        </div>
      </div>

      <!-- Streaming CTA Button -->
      {tvStream && (
        <div class="shrink-0">
          <a
            href={tvStream.streamUrl}
            target="_blank"
            rel="noopener noreferrer nofollow"
            class="inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-[#E10600] hover:bg-red-700 text-white font-extrabold rounded-xl text-xs sm:text-sm shadow-lg hover:shadow-red-600/30 transition-all cursor-pointer"
            aria-label={`Regarder ${seoName} en direct streaming officiel sur ${tvStream.provider}`}
          >
            <span class="w-2 h-2 rounded-full bg-white animate-pulse"></span>
            <span>Direct {tvStream.provider}</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      )}
    </div>

    <!-- Navigation temporelle -->
    <nav class="flex gap-2 sm:gap-3 mb-6 overflow-x-auto pb-1 scrollbar-none" aria-label="Navigation temporelle">
      <a href={`/${chSlug}`} class="shrink-0 px-4 py-2 bg-[#E10600] text-white rounded-full text-xs sm:text-sm font-bold shadow-md">Aujourd'hui</a>
      <a href={`/ce-soir/${chSlug}`} class="shrink-0 px-4 py-2 bg-gray-900/80 border border-gray-800 rounded-full text-xs sm:text-sm font-semibold text-gray-300 hover:text-white hover:border-gray-700 transition-all">Ce soir (21h10)</a>
      <a href={`/en-direct/${chSlug}`} class="shrink-0 px-4 py-2 bg-gray-900/80 border border-gray-800 rounded-full text-xs sm:text-sm font-semibold text-gray-300 hover:text-white hover:border-gray-700 transition-all">En direct</a>
      <a href={`/demain/${chSlug}`} class="shrink-0 px-4 py-2 bg-gray-900/80 border border-gray-800 rounded-full text-xs sm:text-sm font-semibold text-gray-300 hover:text-white hover:border-gray-700 transition-all">Demain</a>
    </nav>

    <!-- High-Viewability Mid-Content Ad -->
    <AdSlot
      slot={ADSENSE_SLOTS.CHANNEL_MID_CONTENT}
      minHeight={250}
      eager={true}
      className="mb-8"
    />

    {programs.length === 0 ? (
      <div class="text-center py-16 text-gray-400 bg-[#111827]/90 rounded-2xl border border-gray-800">
        <p class="text-lg font-semibold">Aucun programme disponible pour aujourd'hui.</p>
      </div>
    ) : (
      <div class="space-y-6">
        <!-- 1. En Direct À l'antenne -->
        {currentProgram && (
          <section class="mb-6">
            <h2 class="text-lg font-black text-white mb-3 flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
              À l'antenne en ce moment sur {seoName}
            </h2>
            <ScheduleProgramRow
              program={currentProgram}
              channel={{ ...channel, logo_url: resolvedLogo }}
              channelSlug={chSlug}
              showEndTime
            />
          </section>
        )}

        <!-- 2. Accordion pour les programmes passés (matinées déjà diffusées) -->
        {pastPrograms.length > 0 && (
          <div class="mb-6">
            <button
              id="btn-toggle-past"
              type="button"
              class="w-full py-3 px-4 rounded-2xl bg-gray-900/80 hover:bg-gray-800/90 border border-gray-800 text-gray-300 text-xs sm:text-sm font-bold flex items-center justify-between transition-colors cursor-pointer"
              aria-expanded="false"
            >
              <span class="flex items-center gap-2">
                <span>⏮️</span>
                <span>Afficher les programmes précédents ({pastPrograms.length} émissions depuis 06h00)</span>
              </span>
              <span id="past-arrow" class="transform transition-transform text-slate-400 font-bold">▼</span>
            </button>
            <div id="past-programs-list" class="hidden mt-3 space-y-2 opacity-80">
              {pastPrograms.map((p) => (
                <ScheduleProgramRow
                  program={p}
                  channel={{ ...channel, logo_url: resolvedLogo }}
                  channelSlug={chSlug}
                  showEndTime
                />
              ))}
            </div>
          </div>
        )}

        <!-- 3. Programmes suivants aujourd'hui et Prime Time -->
        {upcomingPrograms.length > 0 && (
          <section>
            <h2 class="text-lg font-black text-slate-900 mb-3 flex items-center gap-2">
              <span class="w-1.5 h-6 bg-red-600 rounded-full"></span>
              Suite de la programmation aujourd'hui & Prime Time 21:10
            </h2>
            <div class="space-y-2">
              {upcomingPrograms.map((p) => {
                const isPrime = primeProgram?.id === p.id;
                return (
                  <ScheduleProgramRow
                    program={p}
                    channel={{ ...channel, logo_url: resolvedLogo }}
                    channelSlug={chSlug}
                    showEndTime
                    isPrimeTime={isPrime}
                  />
                );
              })}
            </div>
          </section>
        )}
      </div>
    )}

    <!-- Pre-Footer Smart Lazy-Load Ad -->
    <AdSlot
      slot={ADSENSE_SLOTS.PRE_FOOTER}
      minHeight={250}
      eager={false}
      className="my-8"
    />

    <!-- FAQ & Guide SEO Section -->
    <section class="mt-10 mb-8 p-5 sm:p-6 bg-[#111827]/90 border border-gray-800/90 rounded-2xl shadow-xl">
      <h2 class="text-base sm:text-lg font-black text-white mb-3 flex items-center gap-2">
        ℹ️ Guide et horaires {seoName}
      </h2>
      <div class="space-y-3 text-xs sm:text-sm text-gray-300 leading-relaxed">
        <p>
          Retrouvez toute la journée la programmation officielle de <strong>{seoName}</strong>. Suivez les rendez-vous d'information, les magazines, séries et films diffusés à l'antenne.
        </p>
        <p>
          Besoin de savoir ce qui passe maintenant ? Consultez directement notre page <a href={`/en-direct/${chSlug}`} class="text-red-400 font-semibold hover:underline">{seoName} en direct</a> ou préparez votre soirée avec <a href={`/ce-soir/${chSlug}`} class="text-red-400 font-semibold hover:underline">{seoName} ce soir</a>.
        </p>
      </div>
    </section>

    <!-- Maillage rapide autres chaînes -->
    <section class="mb-10 pt-6 border-t border-gray-800">
      <h2 class="text-sm font-black text-white uppercase tracking-wider mb-3">
        📺 Programmes des autres chaînes aujourd'hui
      </h2>
      <div class="flex flex-wrap gap-1.5 sm:gap-2">
        {TOP_CHANNELS.filter(c => c.slug !== chSlug).map((c) => (
          <a
            href={`/${c.slug}`}
            class="px-2.5 py-1 sm:px-3 sm:py-1.5 rounded-lg text-xs font-semibold bg-gray-900/80 border border-gray-800 text-gray-300 hover:bg-[#E10600]/20 hover:text-red-400 hover:border-red-500/40 transition-colors shadow-2xs"
          >
            Programme {c.name}
          </a>
        ))}
      </div>
    </section>

    <RelatedChannels suggestions={relatedChannels} viewMode="aujourdhui" channelName={channel.name} />

    <nav class="mt-10 pt-6 border-t border-gray-800 flex flex-wrap gap-4 text-xs sm:text-sm" aria-label="Retour">
      <a href={`/en-direct/${chSlug}`} class="text-red-400 font-semibold hover:underline">&larr; {seoName} en direct</a>
      <a href={`/ce-soir/${chSlug}`} class="text-red-400 font-semibold hover:underline">&larr; {seoName} ce soir</a>
      <a href="/" class="text-red-400 font-semibold hover:underline">&larr; Tous les programmes ce soir</a>
    </nav>
  </div>

  <!-- Embedded Schedule JSON for Client-Side Dual-Layer Synchronization -->
  <script id="channel-schedule-json" type="application/json" set:html={JSON.stringify(schedulePayload)} />

  <script is:inline>
    // Accordion Toggle for Past Programs
    (function () {
      var btn = document.getElementById('btn-toggle-past');
      var list = document.getElementById('past-programs-list');
      var arrow = document.getElementById('past-arrow');
      if (btn && list) {
        btn.addEventListener('click', function () {
          var isExpanded = btn.getAttribute('aria-expanded') === 'true';
          btn.setAttribute('aria-expanded', String(!isExpanded));
          if (isExpanded) {
            list.classList.add('hidden');
            if (arrow) arrow.style.transform = 'rotate(0deg)';
          } else {
            list.classList.remove('hidden');
            if (arrow) arrow.style.transform = 'rotate(180deg)';
          }
        });
      }
    })();

    // Live Paris Clock
    (function () {
      var clockEl = document.getElementById('paris-clock-text');
      function updateClock() {
        if (!clockEl) return;
        var now = new Date();
        var timeStr = now.toLocaleTimeString('fr-FR', {
          timeZone: 'Europe/Paris',
          hour: '2-digit',
          minute: '2-digit'
        });
        clockEl.textContent = 'En direct · ' + timeStr;
      }
      updateClock();
      setInterval(updateClock, 30000);
    })();
  </script>

  <Footer slot="footer" />
</Layout>
