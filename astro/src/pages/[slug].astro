---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getChannelBySlug, getChannelSlugFromId, getProgramsByChannelAndDate, getTodayDateFR, slugify } from '../utils/supabase';
import { formatDateFR, getParisHour } from '../utils/dates';
import { getRelatedChannelsForSchedule } from '../utils/relatedChannels';
import RelatedChannels from '../components/RelatedChannels.astro';
import ScheduleProgramRow from '../components/ScheduleProgramRow.astro';
import AdSlot from '../components/AdSlot.astro';
import { ADSENSE_SLOTS } from '../utils/adsense';
import { setCacheControl, CACHE_TEN_MINUTES } from '../utils/cachePolicy';
import { channelSeoName, channelTodaySeo } from '../utils/seoCopy';
import { isAdultOrJunkChannel } from '../utils/programSeo';
import { buildChannelScheduleJsonLd } from '../utils/channelJsonLd';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/');

const reserved = new Set([
  'ce-soir', 'maintenant', 'en-direct', 'demain', 'programme', 'recherche',
  'politique-cookies', 'conditions-generales', 'credits', 'films', 'film',
  'series', 'serie', 'acteurs', 'acteur', 'recommandes', 'film-ce-soir',
  'series-ce-soir', 'sport-ce-soir', 'documentaires-ce-soir', 'jeunesse-ce-soir',
  'culture-ce-soir', 'infos-ce-soir', 'divertissement-ce-soir', 'actualites',
  'anniversaire-du-jour', 'anniversaires-acteurs', 'robots.txt', 'sitemap.xml',
]);

if (reserved.has(slug)) return new Response(null, { status: 404 });

const channel = await getChannelBySlug(slug);

if (!channel) {
  return new Response(null, { status: 404 });
}

setCacheControl(Astro.response, CACHE_TEN_MINUTES);

const today = await getTodayDateFR();
import { pickFeaturedProgram } from '../utils/programPick';
import { resolveProgramPoster } from '../utils/programPoster';
import { resolveOgImage } from '../utils/seoImage';

const programs = await getProgramsByChannelAndDate(channel.channel_id, today);
const relatedChannels = await getRelatedChannelsForSchedule(channel, programs, 'aujourdhui', today, 6);
const todayFormatted = formatDateFR(new Date());
const chSlug = getChannelSlugFromId(channel.channel_id);
const canonical = `https://programmecesoir.fr/${chSlug}`;
const seoName = channelSeoName(chSlug, channel.name);
const { title: pageTitle, description: pageDescription } = channelTodaySeo(seoName);
const noindex = isAdultOrJunkChannel(chSlug);

const primeProgram = pickFeaturedProgram(programs, 'ce-soir');
const primePoster = primeProgram ? resolveProgramPoster(primeProgram) : null;
const ogImage = resolveOgImage(primePoster, channel.logo_url);

const timeSlots = [
  { label: 'Matin', filter: (p: { start_time: string }) => { const h = getParisHour(p.start_time); return h >= 6 && h < 12; } },
  { label: 'Après-midi', filter: (p: { start_time: string }) => { const h = getParisHour(p.start_time); return h >= 12 && h < 18; } },
  { label: 'Soirée', filter: (p: { start_time: string }) => { const h = getParisHour(p.start_time); return h >= 18 || h < 6; } },
];

const TOP_CHANNELS = [
  { slug: 'tf1', name: 'TF1' },
  { slug: 'france-2', name: 'France 2' },
  { slug: 'france-3', name: 'France 3' },
  { slug: 'canal-plus', name: 'Canal+' },
  { slug: 'france-5', name: 'France 5' },
  { slug: 'm6', name: 'M6' },
  { slug: 'arte', name: 'ARTE' },
  { slug: 'c8', name: 'C8' },
  { slug: 'w9', name: 'W9' },
  { slug: 'tmc', name: 'TMC' },
  { slug: 'cnews', name: 'CNews' },
  { slug: 'kto', name: 'KTO' },
  { slug: 'antenne-reunion', name: 'Antenne Réunion' },
  { slug: '2m-maroc', name: '2M Maroc' },
  { slug: 'rts-1', name: 'RTS 1' },
  { slug: 'tvpi', name: 'TVPI' },
  { slug: 'rtl9', name: 'RTL9' },
  { slug: '6ter', name: '6ter' },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: `Quel est le programme TV de ${seoName} aujourd'hui ?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: `Retrouvez sur cette page la grille complète des émissions, films, séries et journaux d'information diffusés aujourd'hui sur ${seoName}, du matin jusqu'au soir.`,
      },
    },
    {
      '@type': 'Question',
      name: `Quel est le programme de ${seoName} en direct et ce soir ?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: `Consultez https://programmecesoir.fr/en-direct/${chSlug} pour voir l'émission diffusée en direct à l'antenne, et https://programmecesoir.fr/ce-soir/${chSlug} pour le programme de première partie de soirée (21h10).`,
      },
    },
  ],
};

const jsonLd = [
  ...buildChannelScheduleJsonLd({
    channel,
    channelSlug: chSlug,
    channelName: seoName,
    canonical,
    view: 'aujourdhui',
    programs,
  }),
  faqJsonLd,
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
  noindex={noindex}
  image={ogImage}
  jsonLd={jsonLd}
>
  <Header slot="header" activePath={`/${chSlug}`} />

  <div class="container mx-auto px-3 sm:px-4 py-5 sm:py-8 max-w-5xl">
    <div class="flex items-center gap-3 sm:gap-4 mb-5 sm:mb-8">
      {channel.logo_url && (
        <img
          src={channel.logo_url}
          alt={`Logo ${seoName}`}
          class="w-12 h-12 sm:w-16 sm:h-16 object-contain rounded-xl bg-white border border-slate-200 p-1.5 sm:p-2 shadow-xs shrink-0"
          width="64"
          height="64"
        />
      )}
      <div>
        <h1 class="text-xl sm:text-2xl md:text-3xl font-black text-slate-900 tracking-tight">
          Programme TV {seoName} aujourd'hui — Grille complète
        </h1>
        <p class="text-xs sm:text-sm text-slate-500 capitalize mt-0.5">{todayFormatted}</p>
      </div>
    </div>

    <nav class="flex gap-2 sm:gap-3 mb-6 overflow-x-auto pb-1 scrollbar-none" aria-label="Navigation temporelle">
      <a href={`/${chSlug}`} class="shrink-0 px-3.5 py-1.5 sm:px-4 sm:py-2 bg-blue-600 text-white rounded-full text-xs sm:text-sm font-bold shadow-xs">Aujourd'hui</a>
      <a href={`/ce-soir/${chSlug}`} class="shrink-0 px-3.5 py-1.5 sm:px-4 sm:py-2 bg-white border border-slate-200 rounded-full text-xs sm:text-sm font-semibold text-slate-700 hover:border-blue-300 transition-all">Ce soir (21h10)</a>
      <a href={`/en-direct/${chSlug}`} class="shrink-0 px-3.5 py-1.5 sm:px-4 sm:py-2 bg-white border border-slate-200 rounded-full text-xs sm:text-sm font-semibold text-slate-700 hover:border-blue-300 transition-all">En direct</a>
      <a href={`/demain/${chSlug}`} class="shrink-0 px-3.5 py-1.5 sm:px-4 sm:py-2 bg-white border border-slate-200 rounded-full text-xs sm:text-sm font-semibold text-slate-700 hover:border-blue-300 transition-all">Demain</a>
    </nav>

    <!-- High-Viewability Mid-Content Ad (After header & quick navigation, before schedule) -->
    <AdSlot
      slot={ADSENSE_SLOTS.CHANNEL_MID_CONTENT}
      minHeight={250}
      eager={true}
      className="mb-8"
    />

    {programs.length === 0 ? (
      <div class="text-center py-16 text-slate-400 bg-slate-50 rounded-2xl border border-slate-200">
        <p class="text-lg font-semibold">Aucun programme trouvé pour aujourd'hui.</p>
      </div>
    ) : (
      <div class="space-y-8 sm:space-y-10">
        {timeSlots.map(({ label, filter }) => {
          const slotPrograms = programs.filter(filter);
          if (slotPrograms.length === 0) return null;
          return (
            <section>
              <h2 class="text-lg font-black text-slate-900 mb-3 sm:mb-4 flex items-center gap-2">
                <span class="w-1.5 h-6 bg-blue-600 rounded-full"></span>
                {label}
              </h2>
              <div class="space-y-2">
                {slotPrograms.map((p) => (
                  <ScheduleProgramRow program={p} channel={channel} channelSlug={chSlug} showEndTime />
                ))}
              </div>
            </section>
          );
        })}
      </div>
    )}

    <!-- Pre-Footer Smart Lazy-Load Ad -->
    <AdSlot
      slot={ADSENSE_SLOTS.PRE_FOOTER}
      minHeight={250}
      eager={false}
      className="my-8"
    />

    <!-- FAQ & Guide SEO Section -->
    <section class="mt-10 mb-8 p-5 sm:p-6 bg-slate-50 border border-slate-200 rounded-2xl">
      <h2 class="text-base sm:text-lg font-black text-slate-900 mb-3 flex items-center gap-2">
        ℹ️ Guide et horaires {seoName}
      </h2>
      <div class="space-y-3 text-xs sm:text-sm text-slate-600 leading-relaxed">
        <p>
          Retrouvez toute la journée la programmation officielle de <strong>{seoName}</strong>. Suivez les rendez-vous d'information, les magazines, séries et films diffusés à l'antenne.
        </p>
        <p>
          Besoin de savoir ce qui passe maintenant ? Consultez directement notre page <a href={`/en-direct/${chSlug}`} class="text-blue-600 font-semibold underline">{seoName} en direct</a> ou préparez votre soirée avec <a href={`/ce-soir/${chSlug}`} class="text-blue-600 font-semibold underline">{seoName} ce soir</a>.
        </p>
      </div>
    </section>

    <!-- Maillage rapide autres chaînes -->
    <section class="mb-10 pt-6 border-t border-slate-200">
      <h2 class="text-sm font-black text-slate-900 uppercase tracking-wider mb-3">
        📺 Programmes des autres chaînes aujourd'hui
      </h2>
      <div class="flex flex-wrap gap-1.5 sm:gap-2">
        {TOP_CHANNELS.filter(c => c.slug !== chSlug).map((c) => (
          <a
            href={`/${c.slug}`}
            class="px-2.5 py-1 sm:px-3 sm:py-1.5 rounded-lg text-xs font-semibold bg-white border border-slate-200 text-slate-700 hover:bg-slate-100 hover:text-blue-600 transition-colors shadow-2xs"
          >
            Programme {c.name}
          </a>
        ))}
      </div>
    </section>

    <RelatedChannels suggestions={relatedChannels} viewMode="aujourdhui" channelName={channel.name} />

    <nav class="mt-10 pt-6 border-t border-slate-200 flex flex-wrap gap-4 text-xs sm:text-sm" aria-label="Retour">
      <a href={`/en-direct/${chSlug}`} class="text-blue-600 font-semibold hover:underline">&larr; {seoName} en direct</a>
      <a href={`/ce-soir/${chSlug}`} class="text-blue-600 font-semibold hover:underline">&larr; {seoName} ce soir</a>
      <a href="/" class="text-blue-600 font-semibold hover:underline">&larr; Tous les programmes ce soir</a>
    </nav>
  </div>

  <Footer slot="footer" />
</Layout>
