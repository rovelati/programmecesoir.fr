---
export const prerender = true;

import { PRIME_TIME_DESCRIPTION } from '../utils/primeTime';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import CalendarBar from '../components/CalendarBar.astro';
import Footer from '../components/Footer.astro';
import ChannelCard from '../components/ChannelCard.astro';
import CategoryPills from '../components/CategoryPills.astro';
import CeSoirPourVous from '../components/CeSoirPourVous.astro';
import AdSlot from '../components/AdSlot.astro';
import { ADSENSE_SLOTS } from '../utils/adsense';
import { getTonightPrograms, getChannelSlugFromId, slugify } from '../utils/supabase';
import { channelScheduleUrl, isRegionalFrance3, getChannelSortOrder } from '../utils/channelUrls';
import { resolveProgramPoster } from '../utils/programPoster';
import { formatDateLongFR } from '../utils/dates';
import { pickFeaturedProgram } from '../utils/programPick';
import { buildHubPrefetchUrls } from '../utils/speculationRules';
import { programAbsoluteUrl, shouldIndexProgram, isAdultOrJunkChannel } from '../utils/programSeo';
import { homeSeo } from '../utils/seoCopy';

const tonightPrograms = await getTonightPrograms();
const tonightDate = formatDateLongFR();
const { title: homeTitle, description: homeDescription } = homeSeo();

const byChannel = new Map<string, typeof tonightPrograms>();
for (const program of tonightPrograms) {
  const list = byChannel.get(program.channel_id) ?? [];
  list.push(program);
  byChannel.set(program.channel_id, list);
}

const channels = [...new Map(
  tonightPrograms.map((program) => [program.channel_id, program.channels_fr]),
).values()]
  .filter((channel) => {
    const slug = getChannelSlugFromId(channel.channel_id);
    if (isAdultOrJunkChannel(slug)) return false;
    if (isRegionalFrance3(slug)) return false;
    return true;
  })
  .sort((a, b) => {
    const slugA = getChannelSlugFromId(a.channel_id);
    const slugB = getChannelSlugFromId(b.channel_id);
    const numA = getChannelSortOrder(a.channel_number, slugA);
    const numB = getChannelSortOrder(b.channel_number, slugB);
    return numA - numB;
  });

const channelPrograms = channels.map((channel) => ({
  channel,
  programs: byChannel.get(channel.channel_id) ?? [],
}));

const activeChannels = channelPrograms.filter((cp) => cp.programs.length > 0);
const totalChannelCount = activeChannels.length;

// Pre-render the top 150 major channels server-side for lightning-fast HTML & SEO
const INITIAL_CHANNEL_LIMIT = 150;
const initialChannels = activeChannels.slice(0, INITIAL_CHANNEL_LIMIT);
const remainingChannelCount = Math.max(0, totalChannelCount - INITIAL_CHANNEL_LIMIT);

let posterCount = 0;
const initialCards = initialChannels.map(({ channel, programs }, channelIndex) => {
  const primeProgram = pickFeaturedProgram(programs, 'ce-soir');
  const hasPoster = Boolean(primeProgram && resolveProgramPoster(primeProgram));
  const eagerPoster = hasPoster && posterCount < 8;
  if (hasPoster && eagerPoster) posterCount += 1;
  return {
    channel,
    programs,
    channelIndex,
    eagerPoster: hasPoster ? eagerPoster : false,
    lazyChannelLogo: channelIndex >= 20,
    primeProgram,
  };
});

const prefetchUrls = buildHubPrefetchUrls(activeChannels, getChannelSlugFromId, slugify, 12);

const eveningPicks = initialCards
  .filter(({ primeProgram }) => primeProgram && shouldIndexProgram(primeProgram) && resolveProgramPoster(primeProgram))
  .slice(0, 6)
  .map(({ channel, primeProgram }) => ({ channel, program: primeProgram! }));

const programListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Programmes TV ce soir',
  numberOfItems: initialCards.length,
  itemListElement: initialCards.flatMap((card, index) => {
    const prog = card.primeProgram;
    if (!prog) return [];
    const chSlug = getChannelSlugFromId(card.channel.channel_id);
    return [{
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'BroadcastEvent',
        name: prog.title,
        startDate: prog.start_time,
        endDate: prog.end_time,
        url: shouldIndexProgram(prog)
          ? programAbsoluteUrl(chSlug, prog.title)
          : channelScheduleUrl('ce-soir', chSlug),
        ...(prog.description ? { description: prog.description.substring(0, 200) } : {}),
        location: {
          '@type': 'BroadcastService',
          name: card.channel.name,
          url: `https://programmecesoir.fr/ce-soir/${chSlug}`,
        },
      },
    }];
  }),
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': 'https://programmecesoir.fr/#website',
    url: 'https://programmecesoir.fr',
    name: 'Programme Ce Soir',
    alternateName: 'Programme TV TNT Ce Soir',
    description: 'Guide TV TNT : programme ce soir, en direct et demain sur toutes les chaînes françaises',
    inLanguage: 'fr-FR',
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: 'https://programmecesoir.fr/recherche?qs={search_term_string}',
      },
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': 'https://programmecesoir.fr/#organization',
    name: 'Programme Ce Soir',
    url: 'https://programmecesoir.fr',
    logo: {
      '@type': 'ImageObject',
      url: 'https://programmecesoir.fr/apple-touch-icon.png',
      width: 180,
      height: 180,
    },
    sameAs: [
      'https://www.wikidata.org/wiki/Q138768630',
      'https://bsky.app/profile/programmecesoir.bsky.social',
      'https://www.trustpilot.com/review/programmecesoir.fr',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Programme TNT ce soir',
    description: 'Liste des programmes TNT diffusés ce soir sur les chaînes françaises.',
    url: 'https://programmecesoir.fr',
    inLanguage: 'fr-FR',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://programmecesoir.fr' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'Que passe-t-il ce soir à la télévision ?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Retrouvez le programme TV ce soir et ce qu’il y a à la télé ce soir sur programmecesoir.fr : films, séries, documentaires et émissions sur TF1, France 2, M6, Arte et toutes les chaînes TNT.',
        },
      },
      {
        '@type': 'Question',
        name: 'Quel film passe ce soir à la télé ?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Consultez notre sélection de films ce soir sur toutes les chaînes TNT françaises avec horaires, synopsis et chaînes sur programmecesoir.fr.',
        },
      },
      {
        '@type': 'Question',
        name: 'Quelles séries sont diffusées ce soir ?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Découvrez toutes les séries diffusées ce soir sur la TNT, avec les horaires et chaînes, sur programmecesoir.fr/series-ce-soir.',
        },
      },
      {
        '@type': 'Question',
        name: 'Comment voir le programme TV de demain ?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Le programme TV de demain est disponible sur programmecesoir.fr/demain avec tous les horaires et chaînes TNT.',
        },
      },
    ],
  },
  programListJsonLd,
];
---

<Layout
  title={homeTitle}
  description={homeDescription}
  canonical="https://programmecesoir.fr/"
  prefetchUrls={prefetchUrls}
  prerenderUrls={['/en-direct', '/demain', '/recommandes']}
  jsonLd={jsonLd}
>
  <Header slot="header" activePath="/" />
  <CalendarBar activeSlot="prime" totalChannels={totalChannelCount} />

  <!-- Top Section H1 Title Bar (Compact & Sleek like tvch.ch) -->
  <section class="max-w-6xl mx-auto px-3 sm:px-6 pt-3 pb-1">
    <div class="flex items-center justify-between gap-3 border-b border-gray-800/60 pb-2">
      <div class="min-w-0 flex items-center gap-2">
        <h1 class="text-sm sm:text-base font-extrabold text-white tracking-tight flex items-center gap-2 truncate">
          <span id="page-section-h1-text">Ce qui passe ce soir à la télévision</span>
        </h1>
        <span class="text-xs text-gray-400 truncate hidden xl:inline">
          • <span id="page-section-desc">Programmes sur TF1, France 2, France 3, M6 et toutes les chaînes TNT</span>
        </span>
      </div>
      <span class="text-[11px] font-bold text-amber-300 bg-amber-950/50 border border-amber-800/40 px-2.5 py-0.5 rounded-lg shrink-0 flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
        <span id="page-section-badge-text">⭐ 21h10 Ce soir</span>
      </span>
    </div>
  </section>

  <!-- Live Search Input -->
  <section class="max-w-6xl mx-auto px-3 sm:px-6 pt-2 pb-1">
    <div class="relative max-w-md">
      <input
        id="channel-search-input"
        type="search"
        placeholder="🔍 Rechercher une chaîne ou un programme..."
        class="w-full px-4 py-2 pl-10 rounded-xl bg-gray-900 border border-gray-800 text-white placeholder:text-gray-500 text-xs sm:text-sm focus:outline-none focus:border-red-500 shadow-sm"
        aria-label="Rechercher une chaîne ou un programme"
      />
      <svg class="w-4 h-4 text-gray-500 absolute left-3 top-2.5 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
      </svg>
    </div>
  </section>

  <main id="main-content" class="max-w-6xl mx-auto px-3 sm:px-6 py-2">

    <!-- Liste des Chaînes Widescreen (Horizontal Split Cards like tvch.ch) -->
    {initialCards.length > 0 ? (
      <section aria-label={`${totalChannelCount} chaînes avec programmes ce soir`} class="mb-10">
        <div id="channels-grid" class="flex flex-col gap-3 sm:gap-4">
          {initialCards.map(({ channel, programs, channelIndex, eagerPoster, lazyChannelLogo }, idx) => (
            <>
              <ChannelCard
                channel={channel}
                programs={programs}
                viewMode="ce-soir"
                channelIndex={channelIndex}
                eagerPoster={eagerPoster}
                lazyChannelLogo={lazyChannelLogo}
              />
              {idx === 1 && (
                <div class="w-full rounded-2xl overflow-hidden bg-[#111827]/80 p-3 sm:p-5 border border-gray-800/80 my-2" data-infeed-container>
                  <AdSlot
                    slot={ADSENSE_SLOTS.IN_FEED_CHANNELS}
                    minHeight={250}
                    inFeedWrapper={true}
                    eager={true}
                    className="border-dashed"
                  />
                </div>
              )}
              {idx === 6 && (
                <div class="w-full rounded-2xl overflow-hidden bg-[#111827]/80 p-3 sm:p-5 border border-gray-800/80 my-2" data-infeed-container>
                  <AdSlot
                    slot={ADSENSE_SLOTS.IN_FEED_CHANNELS}
                    minHeight={250}
                    inFeedWrapper={true}
                    eager={false}
                    className="border-dashed"
                  />
                </div>
              )}
            </>
          ))}
        </div>

        {remainingChannelCount > 0 && (
          <div id="load-more-container" class="mt-4 text-center">
            <button
              id="btn-load-more"
              type="button"
              class="w-full py-3.5 px-6 rounded-2xl bg-gray-900 border border-gray-800 hover:border-red-500/60 hover:bg-gray-800 text-white font-extrabold text-sm shadow-md transition-all flex items-center justify-center gap-2 cursor-pointer group"
            >
              <span class="text-base group-hover:scale-110 transition-transform">📺</span>
              <span>Afficher toutes les chaînes (+{remainingChannelCount} chaînes)</span>
            </button>
          </div>
        )}

        <!-- No Results Fallback -->
        <div id="no-search-results" class="hidden text-center py-16 text-gray-400 bg-[#111827]/90 rounded-2xl border border-gray-800 mt-4">
          <p class="text-3xl mb-2">🔍</p>
          <p class="text-base font-bold text-white">Aucune chaîne ou émission correspondante</p>
          <p class="text-xs text-gray-400 mt-1">Essayez un autre mot-clé ou réinitialisez les filtres.</p>
        </div>
      </section>
    ) : (
      <div class="text-center py-16 text-gray-400 bg-[#111827]/90 rounded-2xl border border-gray-800">
        <p class="text-4xl mb-4" aria-hidden="true">📺</p>
        <p class="text-lg font-semibold text-white">Les programmes de ce soir ne sont pas encore disponibles.</p>
        <p class="text-sm mt-1">Veuillez réessayer dans quelques instants.</p>
      </div>
    )}

    {eveningPicks.length > 0 && (
      <div class="mb-12">
        <CeSoirPourVous picks={eveningPicks} />
      </div>
    )}

    <!-- Pre-Footer Smart Lazy-Load Ad (High Viewability before FAQ) -->
    <AdSlot
      slot={ADSENSE_SLOTS.PRE_FOOTER}
      minHeight={250}
      eager={false}
      className="my-10"
    />

    <!-- SEO FAQ Section -->
    <section class="mt-14 pt-10 border-t border-gray-800/80" aria-label="Questions fréquentes sur le programme TV">
      <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-white mb-6">
        Questions fréquentes sur le programme TV ce soir
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <div class="bg-[#111827]/90 border border-gray-800/80 rounded-2xl p-5 sm:p-6 shadow-md text-gray-300">
          <h3 class="font-bold text-white mb-2 text-base">
            Que passe-t-il ce soir à la télévision française ?
          </h3>
          <p class="text-xs sm:text-sm text-gray-300 leading-relaxed">
            Sur Programme Ce Soir, retrouvez les films, séries et émissions de ce soir sur toutes les chaînes gratuites de la TNT (TF1, France 2, France 3, M6, Arte, W9, TMC) et les chaînes thématiques.
          </p>
        </div>

        <div class="bg-[#111827]/90 border border-gray-800/80 rounded-2xl p-5 sm:p-6 shadow-md text-gray-300">
          <h3 class="font-bold text-white mb-2 text-base">
            Quel film passe ce soir à la télé ?
          </h3>
          <p class="text-xs sm:text-sm text-gray-300 leading-relaxed">
            Consultez notre filtre direct <em>Films</em> ou la rubrique dédiée pour découvrir la sélection des longs-métrages diffusés ce soir avec horaires précis, synopsis détaillés, bandes-annonces et casting.
          </p>
        </div>

        <div class="bg-[#111827]/90 border border-gray-800/80 rounded-2xl p-5 sm:p-6 shadow-md text-gray-300">
          <h3 class="font-bold text-white mb-2 text-base">
            Quelles séries sont diffusées ce soir ?
          </h3>
          <p class="text-xs sm:text-sm text-gray-300 leading-relaxed">
            Retrouvez tous les épisodes inédits et rediffusions de séries françaises et internationales diffusées ce soir en cliquant sur le filtre <em>Séries</em> ou sur notre page dédiée aux séries du soir.
          </p>
        </div>

        <div class="bg-[#111827]/90 border border-gray-800/80 rounded-2xl p-5 sm:p-6 shadow-md text-gray-300">
          <h3 class="font-bold text-white mb-2 text-base">
            Comment consulter le programme TV de demain ou en direct ?
          </h3>
          <p class="text-xs sm:text-sm text-gray-300 leading-relaxed">
            Utilisez les liens du menu pour basculer instantanément sur la grille <em>En direct</em> (programmes actuellement diffusés) ou <em>Demain</em> pour anticiper vos soirées télévisées.
          </p>
        </div>
      </div>
    </section>

  </main>

  <Footer slot="footer" />
</Layout>

<!-- Client-side Live Instant Filter & Progressive Loader Script -->
<script>
  (function () {
    const searchInput = document.getElementById('channel-search-input') as HTMLInputElement | null;
    const chips = document.querySelectorAll<HTMLButtonElement>('.filter-chip');
    const grid = document.getElementById('channels-grid');
    const loadMoreBtn = document.getElementById('btn-load-more');
    const loadMoreContainer = document.getElementById('load-more-container');
    const countEl = document.getElementById('visible-count');
    const noResultsEl = document.getElementById('no-search-results');

    let extraLoaded = false;
    let extraLoading = false;
    let activeFilter = 'all';
    let searchQuery = '';

    const MAIN_TNT_SLUGS = new Set([
      'tf1', 'france-2', 'france-3', 'canal-plus', 'canal', 'france-5', 'm6', 'arte',
      'c8', 'w9', 'tmc', 'tfx', 'nrj-12', 'lcp', 'lcp-public-senat', 'france-4',
      'bfm-tv', 'cnews', 'cstar', 'gulli', 'culturebox', 'tf1-series-films',
      'la-chaine-lequipe', 'lequipe', '6ter', 'rmc-story', 'rmc-decouverte', 'cherie-25', 'lci', 'franceinfo'
    ]);

    function createChannelCard(item: any) {
      const card = document.createElement('article');
      card.className = 'snap-item w-full py-2 sm:py-2.5 outline-none focus:ring-2 focus:ring-[#E10600]/50 rounded-2xl';
      card.setAttribute('data-channel-card', '');
      card.setAttribute('data-channel-name', (item.name || '').toLowerCase());
      card.setAttribute('data-channel-slug', item.slug);
      card.setAttribute('data-channel-number', String(item.channelNumber ?? 999));
      card.setAttribute('data-program-title', (item.prime?.title || '').toLowerCase());
      card.setAttribute('data-category', item.catGroup || 'autre');
      card.setAttribute('tabindex', '-1');

      const prime = item.prime;
      const tntBadge = item.tntNum != null
        ? `<span class="text-[9px] font-bold text-gray-300 bg-gray-800/90 px-1.5 py-0.5 rounded shrink-0">CH ${item.tntNum}</span>`
        : item.isSwiss
        ? `<span class="text-[9px] font-bold text-rose-300 bg-rose-950/80 px-1.5 py-0.5 rounded shrink-0">🇨🇭</span>`
        : item.isPaid
        ? `<span class="text-[9px] font-bold text-amber-300 bg-amber-950/80 px-1.5 py-0.5 rounded shrink-0">Payant</span>`
        : item.isLocal
        ? `<span class="text-[9px] font-bold text-emerald-300 bg-emerald-950/80 px-1.5 py-0.5 rounded shrink-0">Locale</span>`
        : '';

      const statusBadge = prime?.live
        ? `<div class="flex items-center gap-1.5 bg-[#E10600] text-white px-2.5 py-1 rounded-lg text-xs font-black shadow-lg animate-pulse"><span class="w-2 h-2 rounded-full bg-white"></span>EN DIRECT</div>`
        : `<div class="bg-gray-900/90 text-amber-300 px-2.5 py-1 rounded-lg text-xs font-black border border-amber-400/30 shadow-md">✨ 21h10</div>`;

      const heroImg = item.heroImageUrl || 'https://images.unsplash.com/photo-1594909122845-11baa439b7bf?auto=format&fit=crop&w=1280&q=80';
      const streamUrl = item.streamUrl || item.channelHref;

      card.innerHTML = `
        <div class="max-w-6xl mx-auto bg-[#111827]/95 border border-gray-800/90 rounded-2xl overflow-hidden shadow-2xl hover:border-gray-700/80 transition-all duration-300">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-0">
            <!-- Left Column: 16:9 Image -->
            <div class="relative lg:col-span-7 aspect-video bg-black/60 overflow-hidden group">
              <img src="${heroImg}" alt="${prime?.title || item.name}" width="640" height="360" class="w-full h-full object-cover object-[center_20%] group-hover:scale-105 transition-transform duration-700 opacity-90" loading="lazy" decoding="async" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1594909122845-11baa439b7bf?auto=format&fit=crop&w=1280&q=80';" />
              <div class="absolute inset-0 bg-gradient-to-t from-[#111827] via-transparent to-black/40 pointer-events-none"></div>

              <!-- Top Badges Overlay -->
              <div class="absolute top-3 sm:top-4 left-3 sm:left-4 right-3 sm:right-4 flex items-center justify-between gap-2 z-30">
                <a href="${item.channelHref}" class="flex items-center gap-1.5 bg-black/85 hover:bg-black/95 backdrop-blur-md px-2.5 sm:px-3 py-1.5 rounded-xl border border-white/15 hover:border-red-500/60 shadow-lg group/ch transition-all max-w-[65%]" title="Programme ${item.name}">
                  <span class="inline-flex items-center justify-center h-6 max-h-6 max-w-[70px] sm:max-w-[80px] overflow-hidden shrink-0">
                    <img src="${item.logo}" alt="${item.name}" class="max-h-6 max-w-[70px] sm:max-w-[80px] w-auto h-auto object-contain group-hover/ch:scale-105 transition-transform" style="max-height: 24px; max-width: 80px; height: 24px; width: auto; object-fit: contain;" loading="lazy" onerror="this.style.display='none'" />
                  </span>
                  ${tntBadge}
                  <svg class="w-3 h-3 text-gray-400 group-hover/ch:text-red-400 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
                </a>
                ${statusBadge}
              </div>

              <!-- Central Play Button -->
              <a href="${streamUrl}" target="_blank" rel="noopener noreferrer nofollow" class="absolute inset-0 flex flex-col items-center justify-center group/play z-20" aria-label="Voir le direct de ${item.name}">
                <div class="w-12 h-12 sm:w-16 sm:h-16 rounded-full bg-[#E10600]/90 text-white flex items-center justify-center shadow-2xl shadow-red-900/50 group-hover:scale-110 group-hover:bg-[#E10600] transition-all duration-300 border border-white/40 sm:border-2 backdrop-blur-sm">
                  <svg class="w-6 h-6 sm:w-8 sm:h-8 text-white translate-x-0.5" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                </div>
              </a>

              <!-- Bottom Timeline -->
              <div class="absolute bottom-0 left-0 right-0 p-3 sm:p-4 z-10 pointer-events-none">
                <div class="flex items-center justify-between text-xs text-white/90 font-medium mb-1.5 drop-shadow">
                  <span>${prime?.time || ''}</span>
                  ${prime?.duration ? `<span>${prime.duration} min</span>` : ''}
                </div>
                ${prime?.live ? `
                  <div class="w-full h-1.5 bg-white/20 rounded-full overflow-hidden backdrop-blur-sm">
                    <div class="live-progress-fill h-full bg-[#E10600] rounded-full transition-all duration-500" style="width: ${prime.progress}%;"></div>
                  </div>
                ` : ''}
              </div>
            </div>

            <!-- Right Column: Metadata & Controls -->
            <div class="lg:col-span-5 p-4 sm:p-5 flex flex-col justify-between bg-[#111827]">
              <div>
                <div class="flex items-center gap-2 mb-2.5 flex-wrap">
                  <span class="text-[11px] font-bold uppercase tracking-wider text-red-400 bg-red-950/50 border border-red-800/40 px-2 py-0.5 rounded">${prime?.genre || 'Programme TV'}</span>
                  <a href="${item.channelHref}" class="text-[11px] font-bold text-gray-400 hover:text-white bg-gray-800/80 hover:bg-gray-700/80 border border-gray-700/60 px-2 py-0.5 rounded transition-colors flex items-center gap-1">
                    <span>${item.name}</span>
                    <svg class="w-2.5 h-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
                  </a>
                </div>
                <h2 class="text-lg sm:text-xl font-black text-white tracking-tight leading-snug mb-2 hover:text-red-400 transition-colors line-clamp-2">
                  <a href="${prime?.href || item.channelHref}">${prime?.title || 'Aucun programme répertorié'}</a>
                </h2>
                ${prime?.description ? `<p class="text-xs sm:text-sm text-gray-300 leading-relaxed line-clamp-2 sm:line-clamp-3 mb-3">${prime.description}</p>` : ''}
              </div>

              <div class="pt-3 border-t border-gray-800/80 space-y-2.5">
                <div class="flex items-center gap-2.5">
                  <a href="${streamUrl}" target="_blank" rel="noopener noreferrer nofollow" class="flex-1 flex items-center justify-center gap-2 bg-[#E10600] hover:bg-red-700 text-white font-bold text-xs sm:text-sm py-2.5 px-3 rounded-xl shadow-lg shadow-red-900/30 hover:scale-[1.02] transition-all">
                    <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                    <span class="truncate">${prime?.live ? 'Regarder en direct' : 'Voir le direct officiel'}</span>
                  </a>
                  ${prime ? `
                    <button type="button" class="push-remind-btn flex items-center gap-1.5 bg-gray-800 hover:bg-gray-700 text-gray-200 font-semibold text-xs py-2.5 px-3.5 rounded-xl border border-gray-700 transition-colors shrink-0 cursor-pointer" data-title="${(prime.title || '').replace(/"/g, '&quot;')}" data-channel="${(item.name || '').replace(/"/g, '&quot;')}" title="M'avertir">
                      <svg class="w-4 h-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
                      <span class="hidden sm:inline">M'avertir</span>
                    </button>
                  ` : ''}
                </div>
                ${item.next ? `
                  <div class="flex items-center justify-between text-xs text-gray-400 bg-gray-900/70 p-2.5 rounded-xl border border-gray-800/60">
                    <div class="flex items-center gap-2 truncate">
                      <span class="text-gray-500 uppercase text-[10px] font-bold">À suivre :</span>
                      <span class="text-gray-300 font-medium truncate">${item.next.title}</span>
                    </div>
                    <span class="text-red-400 font-bold ml-2 shrink-0">${item.next.time}</span>
                  </div>
                ` : ''}
              </div>
            </div>
          </div>
        </div>
      `;
      return card;
    }

    async function loadRemainingChannels() {
      if (extraLoaded || extraLoading) return;
      extraLoading = true;
      if (loadMoreBtn) {
        loadMoreBtn.innerHTML = '<span class="inline-block animate-spin mr-2">⏳</span> Chargement des chaînes...';
      }
      try {
        const res = await fetch('/api/channels-extra.json?mode=ce-soir&offset=150');
        if (res.ok) {
          const data = await res.json();
          if (data.items && grid) {
            data.items.forEach((item: any) => {
              grid.appendChild(createChannelCard(item));
            });
          }
          extraLoaded = true;
          if (loadMoreContainer) loadMoreContainer.style.display = 'none';
        }
      } catch (e) {
        console.error('Error loading extra channels', e);
      } finally {
        extraLoading = false;
        applyFilters();
      }
    }

    if (loadMoreBtn) {
      loadMoreBtn.addEventListener('click', loadRemainingChannels);
    }

    // Category filter chips click handlers
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        activeFilter = chip.getAttribute('data-filter') || 'all';
        chips.forEach((c) => {
          if (c === chip) {
            c.classList.add('bg-gray-800', 'text-white', 'font-bold', 'border-gray-700');
            c.classList.remove('bg-gray-900/80', 'text-gray-400', 'border-transparent');
          } else {
            c.classList.remove('bg-gray-800', 'text-white', 'font-bold', 'border-gray-700');
            c.classList.add('bg-gray-900/80', 'text-gray-400', 'border-transparent');
          }
        });
        applyFilters();
      });
    });

    // Auto load on scroll near bottom
    window.addEventListener('scroll', () => {
      if (!extraLoaded && !extraLoading && window.innerHeight + window.scrollY >= document.body.offsetHeight - 800) {
        loadRemainingChannels();
      }
    }, { passive: true });

    function applyFilters() {
      const cards = document.querySelectorAll<HTMLElement>('[data-channel-card]');
      let visible = 0;
      cards.forEach(card => {
        const name = card.getAttribute('data-channel-name') || '';
        const slug = card.getAttribute('data-channel-slug') || '';
        const chNum = parseInt(card.getAttribute('data-channel-number') || '999', 10);
        const title = card.getAttribute('data-program-title') || '';
        const cat = card.getAttribute('data-category') || '';

        const matchesSearch = !searchQuery ||
          name.includes(searchQuery) ||
          slug.includes(searchQuery) ||
          title.includes(searchQuery) ||
          (chNum <= 50 && `ch ${chNum}`.includes(searchQuery));

        const matchesCategory = activeFilter === 'all' || cat === activeFilter;

        const isVisible = matchesSearch && matchesCategory;
        card.style.display = isVisible ? '' : 'none';
        if (isVisible) visible++;
      });

      const infeedContainers = document.querySelectorAll<HTMLElement>('[data-infeed-container]');
      infeedContainers.forEach(container => {
        container.style.display = searchQuery || activeFilter !== 'all' ? 'none' : '';
      });

      if (noResultsEl) noResultsEl.classList.toggle('hidden', visible > 0);
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
        if (searchQuery && !extraLoaded) {
          loadRemainingChannels();
        } else {
          applyFilters();
        }
      });
    }
  })();
</script>
