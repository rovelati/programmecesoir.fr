---
import type { ChannelRow, ProgramRow } from '../utils/supabase';
import { getChannelSlugFromId } from '../utils/supabase';
import { formatTimeFR, isCurrentlyAiring, progressPercent, durationMinutes } from '../utils/dates';
import { pickFeaturedProgram, pickNextPrograms } from '../utils/programPick';
import { buildProgramOverlayAttr } from '../utils/programOverlayData';
import { programPath } from '../utils/programSeo';
import { getChannelLogo } from '../utils/channelLogos';
import { isPayant, isSuisse, isTntLocale, getTntNumber, FRANCE_3_REGIONS } from '../utils/channelUrls';
import { resolveCardHeroImage, detectCategoryGroup } from '../utils/cardImages';
import { getTvStreamUrl } from '../utils/tvStreams';

interface Props {
  channel: ChannelRow;
  programs: ProgramRow[];
  viewMode?: 'aujourdhui' | 'ce-soir' | 'demain' | 'en-direct';
  channelIndex?: number;
  eagerPoster?: boolean;
  lazyChannelLogo?: boolean;
}

const {
  channel,
  programs,
  viewMode = 'ce-soir',
  channelIndex = 0,
  eagerPoster = true,
  lazyChannelLogo = false,
} = Astro.props;

const slug = getChannelSlugFromId(channel.channel_id);
const resolvedLogo = getChannelLogo(channel.channel_id, channel.logo_url, channel.name);
const channelHref = viewMode === 'en-direct' ? `/en-direct/${slug}` :
                    viewMode === 'demain' ? `/demain/${slug}` :
                    viewMode === 'ce-soir' ? `/ce-soir/${slug}` :
                    `/${slug}`;

const primeProgram = pickFeaturedProgram(programs, viewMode);
const nextPrograms = pickNextPrograms(programs, primeProgram, 1);
const live = primeProgram ? isCurrentlyAiring(primeProgram.start_time, primeProgram.end_time) : false;
const progress = live && primeProgram ? progressPercent(primeProgram.start_time, primeProgram.end_time) : 0;
const primeOverlay = primeProgram ? buildProgramOverlayAttr(primeProgram, { ...channel, logo_url: resolvedLogo }, slug) : null;
const primeHref = primeProgram ? programPath(slug, primeProgram.title) : channelHref;
const tntNum = getTntNumber(channel.channel_number, slug);
const isSwissChannel = isSuisse(slug);
const isPaidChannel = isPayant(channel.channel_number, slug);
const isLocalTnt = isTntLocale(slug);
const tvStream = getTvStreamUrl(slug, channel.name);
const streamUrl = tvStream?.streamUrl || channelHref;

const logoLoading = lazyChannelLogo ? 'lazy' : (channelIndex < 12 ? 'eager' : 'lazy');
const posterLoading = eagerPoster && channelIndex < 6 ? 'eager' : 'lazy';

const heroImageInfo = resolveCardHeroImage(primeProgram);
const catGroup = detectCategoryGroup(primeProgram?.genre, primeProgram?.title);

const startTimeStr = primeProgram ? formatTimeFR(primeProgram.start_time) : '';
const endTimeStr = primeProgram ? formatTimeFR(primeProgram.end_time) : '';
const duration = primeProgram ? durationMinutes(primeProgram.start_time, primeProgram.end_time) : 0;

const startMs = primeProgram ? new Date(primeProgram.start_time).getTime() : 0;
const endMs = primeProgram ? new Date(primeProgram.end_time).getTime() : 0;
const nowMs = Date.now();
const remainingMins = Math.max(0, Math.round((endMs - nowMs) / 60000));

const displayCategory = primeProgram?.genre || 'Programme TV';
const cleanDesc = primeProgram?.description || 'Aucune description détaillée disponible.';

// TMDb rating if available
const ratingValue = (primeProgram as any)?.rating || (primeProgram as any)?.imdb_rating;
const ratingFormatted = ratingValue ? Number(ratingValue).toFixed(1) : null;

const initials = (channel.name || slug).slice(0, 2).toUpperCase();
const fallbackDataUri = `data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='16' fill='%231e293b'/><text x='50%' y='54%' dominant-baseline='middle' text-anchor='middle' fill='%23e10600' font-family='system-ui,sans-serif' font-weight='900' font-size='28'>${initials}</text></svg>`;
---

<article
  class="snap-item w-full py-2 sm:py-2.5 outline-none focus:ring-2 focus:ring-[#E10600]/50 rounded-2xl"
  data-channel-card
  data-channel-name={channel.name.toLowerCase()}
  data-channel-slug={slug}
  data-channel-number={channel.channel_number ?? 999}
  data-program-title={primeProgram?.title?.toLowerCase() ?? ''}
  data-category={catGroup}
  tabindex="-1"
>
  <div class="max-w-6xl mx-auto bg-[#111827]/95 border border-gray-800/90 rounded-2xl overflow-hidden shadow-2xl hover:border-gray-700/80 transition-all duration-300">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-0">
      
      <!-- Left Column: 16:9 Immersive Horizontal Image with Overlay Play Button -->
      <div class="relative lg:col-span-7 aspect-video bg-black/60 overflow-hidden group">
        <img
          src={heroImageInfo.imageUrl}
          alt={primeProgram?.title ? `${primeProgram.title} — ${channel.name}` : channel.name}
          width="640"
          height="360"
          loading={posterLoading}
          decoding="async"
          class="w-full h-full object-cover object-[center_20%] group-hover:scale-105 transition-transform duration-700 opacity-90"
          onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1594909122845-11baa439b7bf?auto=format&fit=crop&w=1280&q=80';"
        />

        <!-- Gradient Vignette -->
        <div class="absolute inset-0 bg-gradient-to-t from-[#111827] via-transparent to-black/40 pointer-events-none"></div>

        <!-- Top Badges Overlay -->
        <div class="absolute top-3 sm:top-4 left-3 sm:left-4 right-3 sm:right-4 flex items-center justify-between gap-2 z-30">
          <!-- Channel Logo Link Pill -->
          <a
            href={channelHref}
            class="flex items-center gap-1.5 bg-black/85 hover:bg-black/95 backdrop-blur-md px-2.5 sm:px-3 py-1.5 rounded-xl border border-white/15 hover:border-red-500/60 shadow-lg group/ch transition-all max-w-[65%]"
            title={`Programme et grille ${channel.name}`}
          >
            {resolvedLogo ? (
              <span class="inline-flex items-center justify-center h-6 max-h-6 max-w-[70px] sm:max-w-[80px] overflow-hidden shrink-0">
                <img
                  src={resolvedLogo}
                  alt={channel.name}
                  class="max-h-6 max-w-[70px] sm:max-w-[80px] w-auto h-auto object-contain group-hover/ch:scale-105 transition-transform"
                  style="max-height: 24px; max-width: 80px; height: 24px; width: auto; object-fit: contain;"
                  loading={logoLoading}
                  onerror={`this.onerror=null; this.src='${fallbackDataUri}';`}
                />
              </span>
            ) : (
              <span class="text-xs font-black tracking-wide text-white group-hover/ch:text-red-400 uppercase transition-colors truncate">{channel.name}</span>
            )}
            {tntNum != null ? (
              <span class="text-[9px] font-bold text-gray-300 bg-gray-800/90 px-1.5 py-0.5 rounded shrink-0">
                CH {tntNum}
              </span>
            ) : isSwissChannel ? (
              <span class="text-[9px] font-bold text-rose-300 bg-rose-950/80 px-1.5 py-0.5 rounded shrink-0">
                🇨🇭
              </span>
            ) : isPaidChannel ? (
              <span class="text-[9px] font-bold text-amber-300 bg-amber-950/80 px-1.5 py-0.5 rounded shrink-0">
                Payant
              </span>
            ) : isLocalTnt ? (
              <span class="text-[9px] font-bold text-emerald-300 bg-emerald-950/80 px-1.5 py-0.5 rounded shrink-0">
                Locale
              </span>
            ) : null}
            <svg class="w-3 h-3 text-gray-400 group-hover/ch:text-red-400 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
            </svg>
          </a>

          <!-- Live Indicator or Prime Badge -->
          {live ? (
            <div class="flex items-center gap-1.5 bg-[#E10600] text-white px-2.5 py-1 rounded-lg text-xs font-black shadow-lg animate-pulse">
              <span class="w-2 h-2 rounded-full bg-white"></span>
              EN DIRECT
            </div>
          ) : viewMode === 'ce-soir' ? (
            <div class="bg-gray-900/90 text-amber-300 px-2.5 py-1 rounded-lg text-xs font-black border border-amber-400/30 shadow-md">
              ✨ 21h10
            </div>
          ) : (
            <div class="bg-gray-900/90 text-white px-2.5 py-1 rounded-lg text-xs font-bold border border-white/10">
              {startTimeStr}
            </div>
          )}
        </div>

        <!-- Central Play Button Link (Opens direct stream or channel page) -->
        <a
          href={streamUrl}
          target="_blank"
          rel="noopener noreferrer nofollow"
          class="absolute inset-0 flex flex-col items-center justify-center group/play z-20"
          aria-label={`Voir le direct de ${channel.name}`}
        >
          <div class="w-12 h-12 sm:w-16 sm:h-16 rounded-full bg-[#E10600]/90 text-white flex items-center justify-center shadow-2xl shadow-red-900/50 group-hover:scale-110 group-hover:bg-[#E10600] transition-all duration-300 border border-white/40 sm:border-2 backdrop-blur-sm">
            <svg class="w-6 h-6 sm:w-8 sm:h-8 text-white translate-x-0.5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M8 5v14l11-7z" />
            </svg>
          </div>
          <!-- On hover tooltip pill -->
          <div class="hidden sm:inline-flex items-center gap-1.5 mt-2 px-3 py-1 rounded-full bg-black/85 backdrop-blur-md text-white text-[11px] font-semibold border border-white/20 shadow-xl opacity-0 group-hover/play:opacity-100 transform translate-y-1 group-hover/play:translate-y-0 transition-all duration-200 pointer-events-none max-w-[90%] truncate">
            <span class="truncate">Voir le direct de {channel.name}</span>
            <svg class="w-3 h-3 text-red-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </div>
        </a>

        <!-- Bottom Timeline / Progress Bar on image -->
        <div class="absolute bottom-0 left-0 right-0 p-3 sm:p-4 z-10 pointer-events-none">
          <div class="flex items-center justify-between text-xs text-white/90 font-medium mb-1.5 drop-shadow">
            <span>{startTimeStr}{endTimeStr ? ` - ${endTimeStr}` : ''}</span>
            {live ? (
              <span class="live-remaining-text font-bold text-red-400" data-start={startMs} data-end={endMs}>
                {remainingMins} min restantes
              </span>
            ) : duration > 0 ? (
              <span>{duration} min</span>
            ) : null}
          </div>
          {live && (
            <div class="w-full h-1.5 bg-white/20 rounded-full overflow-hidden backdrop-blur-sm">
              <div
                class="live-progress-fill h-full bg-[#E10600] rounded-full transition-all duration-500"
                data-start={startMs}
                data-end={endMs}
                style={`width: ${progress}%`}
              ></div>
            </div>
          )}
        </div>
      </div>

      <!-- Right Column: Programme Metadata & Action Controls -->
      <div class="lg:col-span-5 p-4 sm:p-5 flex flex-col justify-between bg-[#111827]">
        <div>
          <!-- Category & Rating Tags -->
          <div class="flex items-center gap-2 mb-2.5 flex-wrap">
            {displayCategory && (
              <span class="text-[11px] font-bold uppercase tracking-wider text-red-400 bg-red-950/50 border border-red-800/40 px-2 py-0.5 rounded">
                {displayCategory}
              </span>
            )}

            <!-- Authentic IMDb Rating Badge if available -->
            {ratingFormatted && (
              <a
                href={`https://www.google.com/search?q=${encodeURIComponent((primeProgram?.title || '') + ' imdb')}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-xs font-black bg-[#F5C518] hover:bg-yellow-400 text-black px-2 py-0.5 rounded shadow-sm transition-colors group/imdb"
                title={`Note IMDb: ${ratingFormatted}/10`}
              >
                <span class="text-[10px] font-black tracking-tighter bg-black text-[#F5C518] px-1 py-0.2 rounded font-sans leading-none">IMDb</span>
                <span class="font-black text-black">★ {ratingFormatted}</span>
              </a>
            )}

            <!-- Channel Schedule Link Pill -->
            <a
              href={channelHref}
              class="text-[11px] font-bold text-gray-400 hover:text-white bg-gray-800/80 hover:bg-gray-700/80 border border-gray-700/60 px-2 py-0.5 rounded transition-colors flex items-center gap-1"
              title={`Grille TV ${channel.name}`}
            >
              <span>{channel.name}</span>
              <svg class="w-2.5 h-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
              </svg>
            </a>

            {slug === 'france-3' && (
              <div class="inline-block" onclick="event.stopPropagation()">
                <select
                  class="text-[10px] font-medium text-gray-300 bg-gray-800 border border-gray-700 rounded px-1.5 py-0.5 focus:outline-none focus:ring-1 focus:ring-red-500 cursor-pointer"
                  onchange="if(this.value) window.location.href=this.value"
                  aria-label="Choisir une région France 3"
                >
                  <option value="">Régions...</option>
                  {FRANCE_3_REGIONS.filter(r => r.slug !== 'france-3').map((reg) => (
                    <option value={`/${reg.slug}`}>{reg.name}</option>
                  ))}
                </select>
              </div>
            )}
          </div>

          <!-- Main Title -->
          <h2 class="text-lg sm:text-xl font-black text-white tracking-tight leading-snug mb-2 hover:text-red-400 transition-colors line-clamp-2">
            <a href={primeHref} data-program={primeOverlay}>
              {primeProgram?.title || 'Aucun programme répertorié'}
            </a>
          </h2>

          <!-- Description / Synopsis -->
          <p class="text-xs sm:text-sm text-gray-300 leading-relaxed line-clamp-2 sm:line-clamp-3 mb-3">
            {cleanDesc}
          </p>
        </div>

        <!-- Bottom Controls & Next Program Preview -->
        <div class="pt-3 border-t border-gray-800/80 space-y-2.5">
          <!-- Primary Actions: Stream Live & Push Notification Reminder -->
          <div class="flex items-center gap-2.5">
            <a
              href={streamUrl}
              target="_blank"
              rel="noopener noreferrer nofollow"
              class="flex-1 flex items-center justify-center gap-2 bg-[#E10600] hover:bg-red-700 text-white font-bold text-xs sm:text-sm py-2.5 px-3 rounded-xl shadow-lg shadow-red-900/30 hover:scale-[1.02] transition-all"
            >
              <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24">
                <path d="M8 5v14l11-7z" />
              </svg>
              <span class="truncate">{live ? 'Regarder en direct' : 'Voir le direct officiel'}</span>
            </a>

            <!-- Push Notification Button -->
            {primeProgram && (
              <button
                type="button"
                class="push-remind-btn flex items-center gap-1.5 bg-gray-800 hover:bg-gray-700 text-gray-200 font-semibold text-xs py-2.5 px-3.5 rounded-xl border border-gray-700 transition-colors shrink-0 cursor-pointer"
                data-title={primeProgram.title}
                data-time={startTimeStr}
                data-channel={channel.name}
                title="M'avertir avant le début"
              >
                <svg class="w-4 h-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                </svg>
                <span class="hidden sm:inline">M'avertir</span>
              </button>
            )}
          </div>

          <!-- Next Programme Sneak Peek -->
          {nextPrograms.length > 0 && (
            <div class="flex items-center justify-between text-xs text-gray-400 bg-gray-900/70 p-2.5 rounded-xl border border-gray-800/60">
              <div class="flex items-center gap-2 truncate">
                <span class="text-gray-500 uppercase text-[10px] font-bold">À suivre :</span>
                <span class="text-gray-300 font-medium truncate">{nextPrograms[0].title}</span>
              </div>
              <span class="text-red-400 font-bold ml-2 shrink-0">{formatTimeFR(nextPrograms[0].start_time)}</span>
            </div>
          )}
        </div>

      </div>

    </div>
  </div>
</article>
