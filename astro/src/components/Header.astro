---
interface Props {
  activePath?: string;
}
const { activePath = '/' } = Astro.props;

const navLinks = [
  { href: '/en-direct', label: 'En direct', icon: 'live' },
  { href: '/', label: 'Ce soir', icon: 'star' },
  { href: '/demain', label: 'Demain', icon: 'calendar' },
  { href: '/recommandes', label: 'Pour vous', icon: 'sparkle' },
];

const exploreLinks = [
  { href: '/film-ce-soir', title: 'Films ce soir', detail: 'Le hub cinéma du prime time.' },
  { href: '/series-ce-soir', title: 'Séries ce soir', detail: 'Les principales diffusions séries.' },
  { href: '/sport-ce-soir', title: 'Sport ce soir', detail: 'Les événements TV à forte demande.' },
  { href: '/documentaires-ce-soir', title: 'Documentaires', detail: 'Docs et magazines du soir.' },
  { href: '/recommandes', title: 'Pour vous', detail: 'Suggestions personnalisées pour ce soir.' },
];

const catalogLinks = [
  { href: '/films', title: 'Films', detail: 'Catalogue film et diffusions.' },
  { href: '/series', title: 'Séries', detail: 'Fiches séries et prochaines diffusions.' },
  { href: '/acteurs', title: 'Acteurs', detail: 'Acteurs à la TV et fiches entités.' },
];

const channelLinks = [
  { href: '/tf1', title: 'TF1' },
  { href: '/france-2', title: 'France 2' },
  { href: '/france-3', title: 'France 3' },
  { href: '/m6', title: 'M6' },
  { href: '/arte', title: 'ARTE' },
  { href: '/canal-plus', title: 'Canal+' },
  { href: '/w9', title: 'W9' },
  { href: '/tmc', title: 'TMC' },
  { href: '/france-5', title: 'France 5' },
];

function isTimeActive(view: 'direct' | 'soir' | 'demain'): boolean {
  if (view === 'direct') return activePath === '/en-direct' || activePath.startsWith('/en-direct/');
  if (view === 'demain') return activePath === '/demain' || activePath.startsWith('/demain/');
  return activePath === '/' || activePath.startsWith('/ce-soir/');
}

function isActive(href: string): boolean {
  if (href === '/') return activePath === '/';
  return activePath === href || activePath.startsWith(href + '/');
}
---

<header class="sticky top-0 z-50 w-full bg-[#0B0F19]/95 backdrop-blur-md border-b border-gray-800/80 transition-all" id="main-header">
  <div class="max-w-7xl mx-auto px-3 sm:px-6">
    <!-- Top bar -->
    <div class="flex items-center justify-between gap-3 h-14 sm:h-16">
      
      <!-- Brand / Logo -->
      <a href="/" class="flex items-center gap-2 sm:gap-2.5 shrink-0 group" aria-label="Programme Ce Soir - Accueil">
        <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-xl bg-[#E10600] flex items-center justify-center shadow-lg shadow-red-900/40 group-hover:scale-105 transition-transform shrink-0">
          <svg class="w-4 h-4 sm:w-5 sm:h-5 text-white translate-x-0.5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M8 5v14l11-7z" />
          </svg>
        </div>
        <div>
          <div class="flex items-center gap-1.5">
            <span class="text-base sm:text-xl font-black tracking-tight text-white group-hover:text-red-400 transition-colors">
              Programme<span class="text-[#E10600]">CeSoir</span>
            </span>
            <span class="text-[9px] sm:text-[10px] font-bold bg-[#E10600]/20 text-[#E10600] border border-[#E10600]/30 px-1.5 py-0.5 rounded uppercase hidden xs:inline">
              FR
            </span>
          </div>
          <p class="text-[10px] text-gray-400 font-medium hidden sm:block">Guide TV TNT & Direct</p>
        </div>
      </a>

      <!-- Desktop nav tabs (like tvch.ch) -->
      <nav class="hidden md:flex items-center bg-gray-900/90 p-1 rounded-xl border border-gray-800 shrink-0" aria-label="Navigation principale">
        {navLinks.map((link) => {
          const active = isActive(link.href);
          return (
            <a
              href={link.href}
              class={`flex items-center gap-1.5 px-3 sm:px-4 py-1.5 rounded-lg text-xs sm:text-sm font-bold transition-all ${
                active
                  ? 'bg-[#E10600] text-white shadow-md'
                  : 'text-gray-300 hover:text-white hover:bg-gray-800/60'
              }`}
            >
              {link.icon === 'live' && (
                <span class={`w-2 h-2 rounded-full ${active ? 'bg-white' : 'bg-[#E10600]'} animate-pulse`}></span>
              )}
              {link.icon === 'star' && (
                <span class="text-xs">⭐</span>
              )}
              {link.icon === 'calendar' && (
                <span class="text-xs">📅</span>
              )}
              {link.label}
            </a>
          );
        })}
      </nav>

      <!-- Right controls: Search, Explorer, Mobile buttons -->
      <div class="flex items-center gap-2 sm:gap-3 shrink-0">
        <!-- Desktop search -->
        <form action="/recherche" method="get" class="relative hidden lg:block w-52 xl:w-60">
          <input
            type="text"
            name="qs"
            placeholder="Rechercher une chaîne..."
            class="w-full pl-9 pr-3 py-1.5 rounded-full bg-gray-900 border border-gray-800 text-white placeholder:text-gray-500 focus:outline-none focus:border-red-500 text-xs sm:text-sm transition-all"
            autocomplete="off"
          />
          <svg class="w-4 h-4 text-gray-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </form>

        <!-- Desktop Explorer Dropdown -->
        <div class="relative hidden lg:block" id="explore-menu-wrap">
          <button
            type="button"
            id="explore-menu-btn"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs sm:text-sm font-bold text-gray-300 hover:text-white rounded-lg bg-gray-900/80 hover:bg-gray-800 border border-gray-800 transition-colors cursor-pointer"
            aria-expanded="false"
            aria-controls="explore-menu-panel"
          >
            <span>Explorer</span>
            <svg class="w-3.5 h-3.5 text-gray-400 transition-transform" id="explore-menu-chevron" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 011.08 1.04l-4.25 4.51a.75.75 0 01-1.08 0l-4.25-4.51a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
            </svg>
          </button>
          <div
            id="explore-menu-panel"
            class="hidden absolute right-0 top-full z-50 mt-2 w-80 overflow-hidden rounded-2xl border border-gray-800 bg-[#111827] p-2 shadow-2xl"
          >
            <div class="space-y-2 max-h-[70vh] overflow-y-auto">
              <div class="rounded-xl bg-gray-900/60 p-2 border border-gray-800/60">
                <p class="px-2 pb-1 text-[10px] font-black uppercase tracking-wider text-red-400">Thématiques</p>
                {exploreLinks.map((link) => (
                  <a href={link.href} class="block rounded-xl px-3 py-2 hover:bg-gray-800/80 transition-colors">
                    <span class="block text-xs font-bold text-white">{link.title}</span>
                    <span class="block text-[11px] text-gray-400 leading-snug">{link.detail}</span>
                  </a>
                ))}
              </div>
              <div class="rounded-xl bg-gray-900/60 p-2 border border-gray-800/60">
                <p class="px-2 pb-1 text-[10px] font-black uppercase tracking-wider text-gray-400">Catalogues</p>
                {catalogLinks.map((link) => (
                  <a href={link.href} class="block rounded-xl px-3 py-2 hover:bg-gray-800/80 transition-colors">
                    <span class="block text-xs font-bold text-white">{link.title}</span>
                    <span class="block text-[11px] text-gray-400 leading-snug">{link.detail}</span>
                  </a>
                ))}
              </div>
              <div class="rounded-xl bg-gray-900/60 p-2 border border-gray-800/60">
                <p class="px-2 pb-1 text-[10px] font-black uppercase tracking-wider text-gray-400">Chaînes TNT</p>
                <div class="grid grid-cols-3 gap-1">
                  {channelLinks.map((link) => (
                    <a href={link.href} class="rounded-lg px-2 py-1 text-xs font-bold text-gray-300 hover:text-white hover:bg-gray-800 transition-colors text-center">
                      {link.title}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Mobile: quick time tabs -->
        <div class="md:hidden flex items-center rounded-xl bg-gray-900 p-0.5 border border-gray-800">
          <a href="/en-direct" class={`px-2.5 py-1 text-[11px] font-black uppercase tracking-wide rounded-lg transition-all ${isTimeActive('direct') ? 'bg-[#E10600] text-white shadow-sm' : 'text-gray-400'}`}>Direct</a>
          <a href="/" class={`px-2.5 py-1 text-[11px] font-black uppercase tracking-wide rounded-lg transition-all ${isTimeActive('soir') ? 'bg-[#E10600] text-white shadow-sm' : 'text-gray-400'}`}>Soir</a>
          <a href="/demain" class={`px-2.5 py-1 text-[11px] font-black uppercase tracking-wide rounded-lg transition-all ${isTimeActive('demain') ? 'bg-[#E10600] text-white shadow-sm' : 'text-gray-400'}`}>Demain</a>
        </div>

        <!-- Mobile menu toggle button -->
        <button
          type="button"
          id="mobile-menu-btn"
          class="md:hidden w-9 h-9 flex items-center justify-center rounded-xl bg-gray-900 hover:bg-gray-800 border border-gray-800 text-gray-300 hover:text-white transition-colors"
          aria-label="Ouvrir le menu"
          aria-expanded="false"
          aria-controls="mobile-menu-panel"
        >
          <svg id="menu-icon-open" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>

    <!-- Mobile: channel scroll strip -->
    <nav class="md:hidden flex items-center gap-1.5 overflow-x-auto pb-2 scrollbar-none -mx-1 px-1" aria-label="Chaînes TV">
      {channelLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            'flex-shrink-0 px-2.5 py-1 rounded-lg text-[11px] font-bold whitespace-nowrap transition-colors',
            isActive(link.href)
              ? 'bg-[#E10600] text-white shadow-sm'
              : 'bg-gray-900/80 text-gray-300 hover:bg-gray-800 border border-gray-800/80',
          ]}
        >
          {link.title}
        </a>
      ))}
    </nav>
  </div>

  <!-- Mobile drawer overlay -->
  <div id="mobile-menu-overlay" class="fixed inset-0 bg-black/70 z-40 hidden md:hidden backdrop-blur-xs" aria-hidden="true"></div>

  <!-- Mobile drawer panel -->
  <div
    id="mobile-menu-panel"
    class="fixed top-0 right-0 z-50 h-full w-[min(100vw,320px)] bg-[#111827] border-l border-gray-800 shadow-2xl transform translate-x-full transition-transform duration-300 ease-out md:hidden flex flex-col"
    aria-hidden="true"
  >
    <div class="flex items-center justify-between px-4 h-14 border-b border-gray-800 shrink-0">
      <span class="text-sm font-black text-white">Menu</span>
      <button type="button" id="mobile-menu-close" class="w-9 h-9 flex items-center justify-center rounded-lg hover:bg-gray-800 text-gray-400 hover:text-white" aria-label="Fermer le menu">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <div class="flex-1 overflow-y-auto px-4 py-4 space-y-5">
      <!-- Search -->
      <form action="/recherche" method="get" class="relative">
        <input
          type="text"
          name="qs"
          placeholder="Rechercher un programme..."
          class="w-full pl-9 pr-3 py-2 rounded-xl bg-gray-900 border border-gray-800 focus:border-red-500 text-white text-sm outline-none"
          autocomplete="off"
        />
        <svg class="w-4 h-4 text-gray-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </form>

      <!-- Primary nav -->
      <div>
        <p class="text-[10px] font-black uppercase tracking-wider text-gray-400 mb-2">Navigation</p>
        <div class="grid grid-cols-2 gap-1.5">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class:list={[
                'px-3 py-2.5 rounded-xl text-xs font-bold transition-colors text-center',
                isActive(link.href)
                  ? 'bg-[#E10600] text-white shadow-xs'
                  : 'bg-gray-900 text-gray-300 hover:bg-gray-800 border border-gray-800',
              ]}
            >
              {link.label}
            </a>
          ))}
        </div>
      </div>

      <!-- Explore hubs -->
      <div>
        <p class="text-[10px] font-black uppercase tracking-wider text-gray-400 mb-2">Thématiques</p>
        <div class="space-y-1">
          {exploreLinks.map((link) => (
            <a href={link.href} class="flex items-center justify-between px-3 py-2 rounded-xl bg-gray-900/60 hover:bg-gray-800 text-gray-300 hover:text-white transition-colors border border-gray-800/60">
              <span class="text-xs font-semibold">{link.title}</span>
              <svg class="w-3.5 h-3.5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  (function () {
    // Explorer Menu Dropdown Toggle
    const exploreBtn = document.getElementById('explore-menu-btn');
    const explorePanel = document.getElementById('explore-menu-panel');
    const exploreChevron = document.getElementById('explore-menu-chevron');

    if (exploreBtn && explorePanel) {
      exploreBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = !explorePanel.classList.contains('hidden');
        if (isOpen) {
          explorePanel.classList.add('hidden');
          exploreBtn.setAttribute('aria-expanded', 'false');
          if (exploreChevron) exploreChevron.classList.remove('rotate-180');
        } else {
          explorePanel.classList.remove('hidden');
          exploreBtn.setAttribute('aria-expanded', 'true');
          if (exploreChevron) exploreChevron.classList.add('rotate-180');
        }
      });

      document.addEventListener('click', (e) => {
        if (!explorePanel.contains(e.target as Node) && !exploreBtn.contains(e.target as Node)) {
          explorePanel.classList.add('hidden');
          exploreBtn.setAttribute('aria-expanded', 'false');
          if (exploreChevron) exploreChevron.classList.remove('rotate-180');
        }
      });
    }

    // Mobile Drawer Toggle
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const mobileClose = document.getElementById('mobile-menu-close');
    const mobilePanel = document.getElementById('mobile-menu-panel');
    const mobileOverlay = document.getElementById('mobile-menu-overlay');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');

    function toggleMobileMenu(open: boolean) {
      if (!mobilePanel || !mobileOverlay) return;
      if (open) {
        mobilePanel.classList.remove('translate-x-full');
        mobileOverlay.classList.remove('hidden');
        document.body.classList.add('overflow-hidden');
        if (iconOpen) iconOpen.classList.add('hidden');
        if (iconClose) iconClose.classList.remove('hidden');
      } else {
        mobilePanel.classList.add('translate-x-full');
        mobileOverlay.classList.add('hidden');
        document.body.classList.remove('overflow-hidden');
        if (iconOpen) iconOpen.classList.remove('hidden');
        if (iconClose) iconClose.classList.add('hidden');
      }
    }

    if (mobileBtn) {
      mobileBtn.addEventListener('click', () => {
        const isOpen = mobilePanel && !mobilePanel.classList.contains('translate-x-full');
        toggleMobileMenu(!isOpen);
      });
    }

    if (mobileClose) {
      mobileClose.addEventListener('click', () => toggleMobileMenu(false));
    }

    if (mobileOverlay) {
      mobileOverlay.addEventListener('click', () => toggleMobileMenu(false));
    }
  })();
</script>
