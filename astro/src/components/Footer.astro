---
const currentYear = new Date().getFullYear();

const headSeoLinks = [
  { href: '/en-direct', label: 'Programme en direct' },
  { href: '/film-ce-soir', label: 'Films ce soir' },
  { href: '/sport-ce-soir', label: 'Sport ce soir' },
  { href: '/demain', label: 'Programme TV demain' },
  { href: '/', label: 'Programme TV ce soir' },
  { href: '/series-ce-soir', label: 'Séries ce soir' },
  { href: '/documentaires-ce-soir', label: 'Documentaires ce soir' },
  { href: '/infos-ce-soir', label: 'Info ce soir' },
];

const channelLinks = [
  { href: '/ce-soir/tf1', label: 'TF1 ce soir' },
  { href: '/ce-soir/france-2', label: 'France 2 ce soir' },
  { href: '/ce-soir/france-3', label: 'France 3 ce soir' },
  { href: '/ce-soir/m6', label: 'M6 ce soir' },
  { href: '/ce-soir/arte', label: 'ARTE ce soir' },
  { href: '/ce-soir/france-5', label: 'France 5 ce soir' },
  { href: '/ce-soir/w9', label: 'W9 ce soir' },
  { href: '/ce-soir/tmc', label: 'TMC ce soir' },
  { href: '/ce-soir/canal-plus', label: 'Canal+ ce soir' },
  { href: '/tvpi', label: 'TVPI aujourd\'hui' },
  { href: '/antenne-reunion', label: 'Antenne Réunion' },
  { href: '/rtl9', label: 'RTL9 aujourd\'hui' },
];

const internationalSites = [
  { name: 'inTVstasera.it', flag: '🇮🇹', url: 'https://www.intvstasera.it/' },
  { name: 'FernsehHeute.de', flag: '🇩🇪', url: 'https://fernsehheute.de/' },
  { name: 'UKTVTonight.co.uk', flag: '🇬🇧', url: 'https://uktvtonight.co.uk/' },
  { name: 'AussieTVTonight.com', flag: '🇦🇺', url: 'https://aussietvtonight.com/' },
  { name: 'TeleEstaNoche.es', flag: '🇪🇸', url: 'https://www.teleestanoche.es/' },
  { name: 'TVWieczor.pl', flag: '🇵🇱', url: 'https://tvwieczor.pl/' },
];
---

<footer class="bg-slate-900 text-slate-400 py-16 border-t border-slate-800">
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-12">
      <div class="space-y-6">
        <a href="/" class="inline-flex items-center gap-2.5 group">
          <img
            src="/favicon.svg"
            alt="Logo ProgrammeCeSoir"
            width="32"
            height="32"
            class="w-8 h-8 rounded-lg shadow-sm group-hover:scale-105 transition-transform"
          />
          <span class="text-lg font-black text-white">Programme<span class="text-[#FF2830]">CeSoir</span></span>
        </a>
        <p class="text-sm leading-relaxed max-w-xs">
          Votre guide TNT pour suivre les programmes en direct, ce soir et demain.
        </p>
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="text-[10px] font-black uppercase tracking-widest text-slate-500">Statut du service : en ligne</span>
        </div>
      </div>

      <div class="space-y-6">
        <h4 class="text-white font-black text-xs uppercase tracking-[0.3em]">Légal</h4>
        <ul class="space-y-3 text-sm font-medium">
          <li><a href="/conditions-generales" class="hover:text-blue-400 transition-colors">Conditions générales</a></li>
          <li><a href="/politique-cookies" class="hover:text-blue-400 transition-colors">Politique cookies</a></li>
          <li><a href="/credits" class="hover:text-blue-400 transition-colors">Crédits</a></li>
          <li><a href="mailto:bruno.bertez@gmail.com" class="text-blue-400 font-bold hover:underline">bruno.bertez@gmail.com</a></li>
          <li class="text-slate-500">12 Square du Roule, 75008 Paris</li>
          <li><a href="https://www.linkedin.com/in/brunobertez/" target="_blank" rel="noopener noreferrer" class="hover:text-blue-400 transition-colors">LinkedIn</a></li>
          <li><a href="https://bsky.app/profile/programmecesoir.bsky.social" target="_blank" rel="me noopener" class="hover:text-blue-400 transition-colors">Bluesky</a></li>
          <li><a href="https://www.trustpilot.com/review/programmecesoir.fr" target="_blank" rel="noopener noreferrer" class="hover:text-blue-400 transition-colors">Trustpilot</a></li>
          <li>
            <button
              type="button"
              id="open-consent-settings"
              class="hover:text-blue-400 transition-colors text-left"
            >
              Paramètres de consentement
            </button>
          </li>
        </ul>
      </div>

      <div class="space-y-6">
        <h4 class="text-white font-black text-xs uppercase tracking-[0.3em]">Explorer</h4>
        <div class="space-y-5">
          <div>
            <p class="mb-3 text-[10px] font-black uppercase tracking-[0.28em] text-slate-500">Pages head prioritaires</p>
            <ul class="space-y-3 text-sm font-medium">
              {headSeoLinks.map((link) => (
                <li><a href={link.href} class="hover:text-blue-400 transition-colors">{link.label}</a></li>
              ))}
            </ul>
          </div>
          <div>
            <p class="mb-3 text-[10px] font-black uppercase tracking-[0.28em] text-slate-500">Chaînes prioritaires</p>
            <ul class="space-y-3 text-sm font-medium">
              {channelLinks.map((link) => (
                <li><a href={link.href} class="hover:text-blue-400 transition-colors">{link.label}</a></li>
              ))}
              <li><a href="/acteurs" class="hover:text-blue-400 transition-colors">Acteurs à la TV</a></li>
            </ul>
          </div>
        </div>
      </div>

      <div class="space-y-6">
        <h4 class="text-white font-black text-xs uppercase tracking-[0.3em]">Avertissement</h4>
        <p class="text-[11px] leading-relaxed text-slate-500 font-medium">
          Les informations présentes sur ce site sont fournies à titre informatif.
          Programme Ce Soir s'efforce de maintenir les grilles à jour, sans toutefois être responsable
          des changements de dernière minute ou des erreurs liées aux décisions des chaînes.
          Tous les logos et marques appartiennent à leurs propriétaires respectifs.
        </p>
      </div>
    </div>

    <div class="mb-10 pt-8 border-t border-slate-800">
      <h4 class="text-white font-black text-xs uppercase tracking-[0.3em] mb-4">Guides TV Internationaux</h4>
      <nav class="flex flex-wrap gap-x-6 gap-y-2 text-xs font-medium" aria-label="Guides TV Internationaux">
        {internationalSites.map((site) => (
          <a href={site.url} class="inline-flex items-center gap-1.5 hover:text-blue-400 transition-colors">
            <span>{site.flag}</span>
            <span>{site.name}</span>
          </a>
        ))}
      </nav>
    </div>

    <div class="pt-8 border-t border-slate-800 flex flex-col md:flex-row justify-between items-center gap-4">
      <div class="text-[10px] uppercase tracking-widest font-bold">
        &copy; {currentYear} programmecesoir.fr
      </div>
      <div class="flex items-center gap-2 rounded-full border border-slate-700/60 bg-slate-950/40 px-3 py-1">
        <span class="flex h-3.5 w-6 overflow-hidden rounded-[3px] border border-slate-700/70">
          <span class="w-1/3 bg-blue-600"></span>
          <span class="w-1/3 bg-white"></span>
          <span class="w-1/3 bg-red-500"></span>
        </span>
        <span class="text-[9px] font-black uppercase tracking-[0.25em] text-slate-200">Made in France</span>
      </div>
    </div>
  </div>
</footer>

<script is:inline>
  document.getElementById('open-consent-settings')?.addEventListener('click', () => {
    if (typeof window.__unicapi === 'function') {
      window.__unicapi('openunic');
    }
  });
</script>
