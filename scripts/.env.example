# Environment Variables for EPG Importer

# Supabase Configuration
SUPABASE_URL=https://qmuqhpxvgfnfqusbumpo.supabase.co
SUPABASE_SERVICE_KEY=your-service-key-here

# Logging
LOG_FILE=/tmp/epg_importer.log

# Import status tracking (optional)
IMPORT_STATUS_TABLE=import_status
IMPORT_STATUS_ID=epg_fr

# Optional tuning
RETENTION_DAYS=2
SUPABASE_MAX_RETRIES=6
SUPABASE_RETRY_DELAY=2
LOGOS_SUBDIR=loghi
LOGO_DOWNLOAD_TIMEOUT=20
LOGO_MAX_BYTES=2097152
LOGO_PLACEHOLDER_ON_FAIL=1

# Search engine notifications
INDEXNOW_ENABLED=1
INDEXNOW_KEY=your-indexnow-key-here
INDEXNOW_TIMEOUT=20
INDEXNOW_BATCH_SIZE=25
INDEXNOW_REQUEST_DELAY_MS=250
INDEXNOW_MAX_URLS=120
INDEXNOW_MAX_RETRIES=3
WEBSUB_ENABLED=1
WEBSUB_HUB_URLS=https://websub.superfeedr.com/,https://pubsubhubbub.appspot.com/
WEBSUB_TIMEOUT=20
WEBSUB_TOPIC_BATCH_SIZE=25
WEBSUB_REQUEST_DELAY_MS=750
WEBSUB_HUB_DELAY_MS=1250
WEBSUB_MAX_RETRIES=4
WEBSUB_OPTIONAL_HUB_PATTERNS=pubsubhubbub.appspot.com
NOTIFY_INCLUDE_SITEMAPS=1
GOOGLE_INDEXING_ENABLED=0
GOOGLE_INDEXING_SERVICE_ACCOUNT_FILE=/path/to/google-indexing-service-account.json
GOOGLE_INDEXING_TIMEOUT=20
GOOGLE_INDEXING_URL_TYPE=URL_UPDATED
GOOGLE_INDEXING_REQUEST_DELAY_MS=250
GOOGLE_INDEXING_MAX_URLS=16
GOOGLE_INDEXING_DAILY_BUDGET=16
GOOGLE_INDEXING_MAX_RETRIES=3
GOOGLE_INDEXING_ROOT_PATHS=/,/en-direct,/demain,/film-ce-soir,/series-ce-soir,/sport-ce-soir
GOOGLE_INDEXING_TARGET_CHANNELS=tf1,france-2,france-3,m6,arte,canal,tmc,w9,cnews,lci
GOOGLE_HEAD_PINNED_TARGET_CHANNELS=tf1,france-2,france-3,m6,arte,canal
GOOGLE_HEAD_ROTATION_TARGET_CHANNELS=france-5,franceinfo,bfm-tv,cstar,gulli,6ter,rmc-decouverte,rmc-story
GOOGLE_URL_INSPECTION_ENABLED=0
GOOGLE_URL_INSPECTION_SITE_URL=https://programmecesoir.fr/
GOOGLE_URL_INSPECTION_TIMEOUT=25
GOOGLE_URL_INSPECTION_LANGUAGE_CODE=fr-FR
GOOGLE_URL_INSPECTION_ROOT_PATHS=/,/en-direct,/demain,/film-ce-soir,/series-ce-soir,/sport-ce-soir
GOOGLE_URL_INSPECTION_TARGET_CHANNELS=tf1,france-2,france-3,m6,arte,canal,tmc,w9,cnews,lci
GOOGLE_URL_INSPECTION_HISTORY_DAYS=7
GOOGLE_URL_INSPECTION_STABLE_DAYS=3
GOOGLE_SEARCH_ANALYTICS_DAYS=7
GA4_ANALYTICS_ENABLED=1
GA4_PROPERTY_ID=
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_PROPERTY_DISPLAY_NAME=
GA4_DISCOVERY_ENABLED=1
GA4_TIMEOUT=30
GA4_DAYS=7
GA4_DELAY_DAYS=1
GA4_TOP_PAGES=10

# Program image enricher
TMDB_API_KEY=your-tmdb-api-key-here
IMAGE_BASE_PATH=/home/u12345/domains/programmecesoir.fr/public_html/images/programs
IMAGE_BASE_URL=https://programmecesoir.fr/images/programs
IMAGE_ENRICHER_BATCH_SIZE=100
IMAGE_ENRICHER_TIMEOUT=20
IMAGE_ENRICHER_LOG_FILE=/tmp/program_image_enricher.log
SLEEP_BETWEEN_REQUESTS=0.25
